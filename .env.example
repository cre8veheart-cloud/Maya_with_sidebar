# ── Anthropic (MAYA intelligence engine) ───────────────────────────────────────
# Required for the MAYA chat API route.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Optional: override the default Claude model.
# Example: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# Default provider for the MAYA chat API route.
# Supported values: anthropic, openclaw, openai
MAYA_PROVIDER=anthropic


# ── OpenAI / ChatGPT (optional MAYA provider) ────────────────────────────────────
# Required only when MAYA_PROVIDER=openai or ChatGPT is selected in Settings.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: override the default OpenAI model.
# Example: gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ── OpenClaw (optional alternate MAYA backend) ───────────────────────────────────
# Example local gateway URL:
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_BASE_URL=
# Optional bearer token if your OpenClaw gateway requires auth.
OPENCLAW_API_KEY=
# Optional: override the default OpenClaw model/route.
OPENCLAW_MODEL=openclaw

# ── Gemini (internal executive advisory layer) ────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
# Create a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini augments each executive internally; it is not a user-selectable chatbot.
GEMINI_MODEL=gemini-3.6-flash
# Set false for an immediate kill switch. Missing/failed Gemini silently falls back.
MAYA_GEMINI_ENABLED=true

# ── NextAuth ─────────────────────────────────────────────────────────────────────
# Full URL of your deployment. Must match exactly — mismatch causes HTTP 409.
# Local:      NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://your-vercel-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Random secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-a-random-32-byte-hex-string

# ── MAYA user list (invite-only) ─────────────────────────────────────────────────
# JSON array. Generate bcrypt hashes with:
#   node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
MAYA_USERS=[{"id":"u1","name":"Your Name","email":"you@example.com","password":"$2b$12$...bcrypt-hash-here...","org":"Your Org","role":"CEO"}]

# ── Private beta access ────────────────────────────────────────────────────────
# Comma-separated invite codes. Do not expose these values to the client.
BETA_INVITE_CODES=maya-invite-one,maya-invite-two
# Separate 32+ character secret used only to sign httpOnly beta sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETA_SESSION_SECRET=replace-with-a-random-32-byte-hex-string
# One-time redemption storage. Install an Upstash Redis integration through the
# Vercel Marketplace (Vercel KV is no longer first-party) and provide its REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Supabase durable MAYA workspace storage ───────────────────────────────────
# Server-owned persistent profiles, role lenses, sessions, memory, and vaults.
# The service-role key must remain server-only. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
